<launch>
  <arg name="car_mode" default="mini_mec_six_arm"/>
  <arg name="moveit_num" default="six_arm"/>
  <node name="$(arg moveit_num)_car_location_color" pkg="wheeltec_arm_pick" type="$(arg moveit_num)_car_location_color" output="screen">
    <param name="car_mode" type="string" value="$(arg car_mode)"/>
    <param name="rotate_mode" type="string" value="holder"/> <!--六自由度机械臂夹取色块后旋转方式选择1.chassis 2.holder)-->
  	<!-- <param name="x_p" value="0.15"/>  
  	<param name="x_i" value="0.0"/> 
  	<param name="x_d" value="0.04"/>
  	<param name="y_p" value="0.15"/>   
  	<param name="y_i" value="0.0"/> 
  	<param name="y_d" value="0.04"/>
    <param name="z_p" value="0.3"/>   
    <param name="z_i" value="0.0"/> 
    <param name="z_d" value="0.03"/> -->

    <!-- 修改后的PID参数 - 降低移动速度 -->
<param name="x_p" value="0.10"/>   <!-- 降低比例增益，减小响应速度 -->
<param name="x_i" value="0.0"/> 
<param name="x_d" value="0.03"/>   <!-- 降低微分增益，减少过冲 -->

<param name="y_p" value="0.10"/>   <!-- 降低比例增益，减小响应速度 -->
<param name="y_i" value="0.0"/> 
<param name="y_d" value="0.03"/>   <!-- 降低微分增益，减少过冲 -->

<param name="z_p" value="0.20"/>   <!-- 降低比例增益，减小响应速度 -->
<param name="z_i" value="0.0"/> 
<param name="z_d" value="0.02"/>   <!-- 降低微分增益，减少过冲 -->
  	<!-- <param name="color_location_x" value="0.0364"/>  
  	<param name="color_location_y" value="0.0594"/> -->

    <param name="color_location_x" value="0.0230"/>  
  	<param name="color_location_y" value="0.0702"/>
  </node>
</launch>
